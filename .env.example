# =====================================================================
# Gestion Locative — variables d'environnement
# Copier ce fichier :  cp .env.example .env   puis adapter les valeurs.
# Ne JAMAIS commiter le fichier .env (il est dans .gitignore).
# =====================================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=gl_user
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=db_gestion_locative
# Port exposé sur la machine hôte (5433 pour éviter le conflit avec un PostgreSQL local)
POSTGRES_HOST_PORT=5433

# ---------- Authentification JWT (partagée par les 4 microservices) ----------
# Générer une valeur forte, ex. : openssl rand -base64 48
JWT_SECRET=change_me_with_a_long_random_secret_of_at_least_32_chars
JWT_EXPIRES_IN=1h

# ---------- Environnements d'exécution ----------
NODE_ENV=production
SPRING_PROFILES_ACTIVE=prod

# ---------- Frontend : URLs des API vues par le navigateur (fixées au build) ----------
# Par défaut, chemins relatifs relayés par nginx vers les microservices.
FRONTEND_API_BIENS_URL=/api/biens
FRONTEND_API_LOCATAIRES_URL=/api/locataires
FRONTEND_API_LOYERS_URL=/api/loyers
FRONTEND_API_QUITTANCES_URL=/api/quittances

