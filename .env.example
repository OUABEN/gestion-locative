# =====================================================================
# Gestion Locative — variables d'environnement
# Copier ce fichier :  cp .env.example .env   puis adapter les valeurs.
# Ne JAMAIS commiter le fichier .env (il est dans .gitignore).
# =====================================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=gl_user
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=db_gestion_locative
# Port exposé sur la machine hôte (5433 pour éviter le conflit avec un PostgreSQL local)
POSTGRES_HOST_PORT=5433

# ---------- Authentification JWT (UN SEUL secret, partagé par les 4 microservices) ----------
# Générer une valeur forte, ex. : openssl rand -base64 48   (32 caractères minimum)
JWT_SECRET=change_me_with_a_long_random_secret_of_at_least_32_chars
JWT_EXPIRES_IN=24h

# ---------- Environnements d'exécution ----------
NODE_ENV=production
SPRING_PROFILES_ACTIVE=prod

# ---------- URLs inter-services (noms Docker exacts : db, biens, locataires, loyers, quittances) ----------
BIENS_SERVICE_URL=http://biens:8081
LOCATAIRES_SERVICE_URL=http://locataires:8082
LOYERS_SERVICE_URL=http://loyers:8083
QUITTANCES_SERVICE_URL=http://quittances:8084

# ---------- Ports exposés sur la machine hôte ----------
FRONTEND_HOST_PORT=3000
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ---------- Frontend : URLs des API vues par le navigateur (fixées au build) ----------
# Par défaut, chemins relatifs relayés par nginx vers les microservices.
FRONTEND_API_BIENS_URL=/api/biens
FRONTEND_API_LOCATAIRES_URL=/api/locataires
FRONTEND_API_LOYERS_URL=/api/loyers
FRONTEND_API_QUITTANCES_URL=/api/quittances

# =====================================================================
# MODE LOCAL (hors Docker) — à exporter dans le terminal de chaque service,
# PAS dans ce fichier (docker compose lirait ces valeurs) :
#   BIENS_SERVICE_URL=http://localhost:8081
#   LOCATAIRES_SERVICE_URL=http://localhost:8082
#   LOYERS_SERVICE_URL=http://localhost:8083
#   QUITTANCES_SERVICE_URL=http://localhost:8084
#   base PostgreSQL : localhost:5433 (conteneur db) avec POSTGRES_USER / POSTGRES_PASSWORD ci-dessus
# Voir docs/DEPLOIEMENT.md
# =====================================================================
