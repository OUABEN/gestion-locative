# URL du microservice Biens
# En développement avec Vite proxy, '/api' est relayé vers http://localhost:8081
VITE_API_BIENS_URL=/api/biens

# URL du service d'authentification centralisé (développé par l'équipe Auth)
VITE_AUTH_URL=http://localhost:8080

# Mode d'authentification :
# - 'token' : permet de coller un JWT généré (npm run token dans backend_gestion_biens)
# - 'api'   : appel standard POST /api/auth/login
VITE_AUTH_MODE=token

