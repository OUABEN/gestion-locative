        {
          "name": "1.1 Register Bailleur éphémère (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now();",
                  "pm.environment.set('uniqueSuffix', ts);",
                  "pm.environment.set('bailleurEmail', `bailleur_${ts}@test-ql.ma`);",
                  "pm.environment.set('bailleurPassword', 'SecretPass123!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut HTTP 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Token JWT et utilisateur retournés', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.expect(json.user).to.have.property('email');",
                  "    pm.expect(json.user.role).to.eql('BAILLEUR');",
                  "    pm.environment.set('token', json.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{bailleurEmail}}\",\n  \"password\": \"{{bailleurPassword}}\",\n  \"nom\": \"Bailleur Test\",\n  \"prenom\": \"Mohamed\",\n  \"role\": \"BAILLEUR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
