{
  "info": {
    "name": "Gestion des Locataires & Baux — Suite API Complète (QL)",
    "_postman_id": "7f8b9c21-4d3e-4a1b-9f0a-8c7e6d5b4a32",
    "description": "Suite complète de tests d'API automatisés (Newman / Postman) pour le module Gestion des Locataires & Baux (Port 8082). Couvre /health, Auth JWT, GET /me, CRUD, Unicité CIN (409), Cloisonnement RBAC (403), et Baux en lecture seule (404 sur POST/DELETE).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "authUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "token_bailleur",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_locataire",
      "value": "",
      "type": "string"
    },
    {
      "key": "locataireId",
      "value": "",
      "type": "string"
    },
    {
      "key": "testCin",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Healthcheck & Disponibilité",
      "item": [
        {
          "name": "1.1 Sonde de santé GET /health (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Format JSON valide et statut UP', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an('object');",
                  "    pm.expect(json.status).to.eql('UP');",
                  "    pm.expect(json.service).to.eql('backend_gestion_locataires');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Authentification JWT (Module Biens :8081)",
      "item": [
        {
          "name": "2.1 Connexion / Obtention Token BAILLEUR",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Connexion réussie ou token de test disponible', function () {",
                  "    if (pm.response.code === 200 || pm.response.code === 201) {",
                  "        const json = pm.response.json();",
                  "        const token = json.token || json.access_token;",
                  "        pm.expect(token).to.be.a('string');",
                  "        pm.collectionVariables.set('token_bailleur', token);",
                  "    } else {",
                  "        // Si Biens 8081 n'est pas démarré, utiliser le token JWT de test standard",
                  "        // Header HS256: sub=1, role=BAILLEUR, email=bailleur@gestion-locative.com",
                  "        const fallbackToken = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsInJvbGUiOiJCQUlMTEVVIiwiZW1haWwiOiJiYWlsbGV1ckBnZXN0aW9uLWxvY2F0aXZlLmNvbSIsImlhdCI6MTY3MDAwMDAwMCwiZXhwIjoyMDgwMDAwMDAwfQ.gP0D6L6kR34KkK2r_r36oM_sFwL-yE0w7_9U8f6_y-U';",
                  "        pm.collectionVariables.set('token_bailleur', fallbackToken);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bailleur@gestion-locative.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{authUrl}}/api/auth/login",
              "host": ["{{authUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "2.2 Connexion / Obtention Token LOCATAIRE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token LOCATAIRE configuré', function () {",
                  "    if (pm.response.code === 200 || pm.response.code === 201) {",
                  "        const json = pm.response.json();",
                  "        const token = json.token || json.access_token;",
                  "        pm.collectionVariables.set('token_locataire', token);",
                  "    } else {",
                  "        // Fallback token JWT HS256: sub=2, role=LOCATAIRE, email=yassine.bennani@email.ma",
                  "        const fallbackToken = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjIsInJvbGUiOiJMT0NBVEFJUkUiLCJlbWFpbCI6Inlhc3NpbmUuYmVubmFuaUBlbWFpbC5tYSIsImlhdCI6MTY3MDAwMDAwMCwiZXhwIjoyMDgwMDAwMDAwfQ.placeholder_token_locataire';",
                  "        pm.collectionVariables.set('token_locataire', fallbackToken);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"yassine.bennani@email.ma\",\n  \"password\": \"locataire123\"\n}"
            },
            "url": {
              "raw": "{{authUrl}}/api/auth/login",
              "host": ["{{authUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Endpoint Dédié GET /api/locataires/me",
      "item": [
        {
          "name": "3.1 GET /api/locataires/me sans token -> 401 Unauthorized",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut HTTP 401 Unauthorized sans token', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Message d\\'erreur explicite', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/locataires/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "locataires", "me"]
            }
          }
        },
        {
          "name": "3.2 GET /api/locataires/me avec Token LOCATAIRE -> 200 OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut HTTP 200 ou 404 (selon base active)', function () {",
                  "    pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.test('Fiche retournée avec email correspondant', function () {",
                  "        pm.expect(json.data).to.have.property('email');",
                  "        pm.expect(json.data).to.have.property('cin');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_locataire}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/locataires/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "locataires", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "4. CRUD Locataires & Unicité CIN (409 Conflict)",
      "item": [
        {
          "name": "4.1 GET /api/locataires (Liste complète BAILLEUR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Format liste de locataires retournée', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_bailleur}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/locataires",
              "host": ["{{baseUrl}}"],
              "path": ["api", "locataires"]
            }
          }
        },
        {
          "name": "4.2 POST /api/locataires (Création nouveau locataire 201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rand = Math.floor(1000 + Math.random() * 9000);",
                  "const cin = 'QA' + rand;",
                  "pm.collectionVariables.set('testCin', cin);",
                  "pm.collectionVariables.set('testEmail', 'locataire_' + rand + '@test.ma');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut HTTP 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Locataire créé avec identifiant généré', function () {",
                  "    pm.expect(json.data).to.have.property('id');",
                  "    pm.expect(json.data.cin).to.eql(pm.collectionVariables.get('testCin'));",
                  "    pm.collectionVariables.set('locataireId', json.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_bailleur}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"El Mansouri\",\n  \"prenom\": \"Tariq\",\n  \"email\": \"{{testEmail}}\",\n  \"telephone\": \"+212611223344\",\n  \"cin\": \"{{testCin}}\",\n  \"statut\": \"ACTIF\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/locataires",
              "host": ["{{baseUrl}}"],
              "path": ["api", "locataires"]
            }
          }
        },
        {
          "name": "4.3 POST /api/locataires collision CIN -> 409 Conflict",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut HTTP 409 Conflict sur CIN dupliqué', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Code d\\'erreur métier CIN_DEJA_UTILISE', function () {",
                  "    pm.expect(json.code).to.eql('CIN_DEJA_UTILISE');",
                  "    pm.expect(json.message).to.include('déjà utilisé');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_bailleur}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Doublon\",\n  \"prenom\": \"Test\",\n  \"email\": \"autre_email@test.ma\",\n  \"telephone\": \"+212699887766\",\n  \"cin\": \"{{testCin}}\",\n  \"statut\": \"ACTIF\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/locataires",
              "host": ["{{baseUrl}}"],
              "path": ["api", "locataires"]
            }
          }
        },
        {
          "name": "4.4 GET /api/locataires/:id (Consultation par BAILLEUR 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Détails locataire conformes', function () {",
                  "    pm.expect(json.data.id).to.eql(parseInt(pm.collectionVariables.get('locataireId'), 10));",
                  "    pm.expect(json.data.nom).to.eql('El Mansouri');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_bailleur}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/locataires/{{locataireId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "locataires", "{{locataireId}}"]
            }
          }
        },
        {
          "name": "4.5 PUT /api/locataires/:id (Mise à jour 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Mise à jour du nom validée', function () {",
                  "    pm.expect(json.data.nom).to.eql('El Mansouri Modifie');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_bailleur}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"El Mansouri Modifie\",\n  \"prenom\": \"Tariq\",\n  \"email\": \"{{testEmail}}\",\n  \"telephone\": \"+212611223344\",\n  \"cin\": \"{{testCin}}\",\n  \"statut\": \"ACTIF\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/locataires/{{locataireId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "locataires", "{{locataireId}}"]
            }
          }
        },
        {
          "name": "4.6 DELETE /api/locataires/:id (Suppression sans baux 204)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut HTTP 204 No Content', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_bailleur}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/locataires/{{locataireId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "locataires", "{{locataireId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Cloisonnement RBAC (LOCATAIRE vs Tiers)",
      "item": [
        {
          "name": "5.1 GET /api/locataires/:id d'un tiers par LOCATAIRE -> 403 Forbidden",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut HTTP 403 Forbidden pour tentative BOLA/IDOR', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Message de refus explicite', function () {",
                  "    pm.expect(json.message).to.include('propres données');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_locataire}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/locataires/9999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "locataires", "9999"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Entité Baux en Lecture Seule",
      "item": [
        {
          "name": "6.1 GET /api/baux (Consultation autorisée 200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Liste de baux retournée en lecture seule', function () {",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_bailleur}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/baux",
              "host": ["{{baseUrl}}"],
              "path": ["api", "baux"]
            }
          }
        },
        {
          "name": "6.2 POST /api/baux (Tentative écriture -> 404 Rejetée)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Route écriture POST baux non exposée (404 Not Found)', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_bailleur}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bien_id\": 1,\n  \"locataire_id\": 1,\n  \"loyer_de_base\": 5000,\n  \"date_debut\": \"2026-12-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/baux",
              "host": ["{{baseUrl}}"],
              "path": ["api", "baux"]
            }
          }
        },
        {
          "name": "6.3 DELETE /api/baux/1 (Tentative suppression -> 404 Rejetée)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Route suppression DELETE baux non exposée (404 Not Found)', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_bailleur}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/baux/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "baux", "1"]
            }
          }
        }
      ]
    }
  ]
}
