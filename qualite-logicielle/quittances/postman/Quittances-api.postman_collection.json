              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401 avec JWT mal forme', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "200 - Identite BAILLEUR (JWT de test)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('tokenBailleur')) {",
                  "    console.warn('Scenario ignore : fournir un JWT BAILLEUR de test valide.');",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Type de contenu JSON', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "pm.test('Corps JSON avec sujet et autorites', function () {",
                  "    const corps = pm.response.json();",
                  "    pm.expect(corps.sujet).to.be.a('string').and.not.empty;",
                  "    pm.expect(corps.autorites).to.be.an('array').that.includes('ROLE_BAILLEUR');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBailleur}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/identite",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "identite"
              ]
            }
          }
        },
        {
          "name": "403 - Liste avec role GESTIONNAIRE",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('tokenGestionnaire')) {",
                  "    console.warn('Scenario ignore : fournir un JWT GESTIONNAIRE de test valide.');",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 403 pour le role interdit', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenGestionnaire}}"
