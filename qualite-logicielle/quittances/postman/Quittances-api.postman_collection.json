{
  "info": {
    "_postman_id": "6e76b0e1-2db0-4b9b-a2f4-4a879c69427e",
    "name": "Quittances API - Phase 3",
    "description": "Scenarios HTTP en lecture seule pour l'authentification, l'autorisation et l'isolation documentaire. Basee sur les routes de la collection DarLoc existante. Les scenarios exigeant un JWT valide ou des documents de test sont ignores tant que leurs variables ne sont pas fournies.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Authentification et autorisation",
      "item": [
        {
          "name": "401 - Identite sans JWT",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/identite",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "identite"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401 sans JWT', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "401 - Liste sans JWT",
