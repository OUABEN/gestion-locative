    {
      "name": "02 - Consultation et isolation",
      "item": [
        {
          "name": "200 - Etat du service",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/systeme/etat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "systeme",
                "etat"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Type de contenu JSON', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "pm.test('Structure de l etat du service', function () {",
                  "    const corps = pm.response.json();",
                  "    pm.expect(corps.service).to.eql('service-quittances');",
                  "    pm.expect(corps.statut).to.eql('OPERATIONNEL');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "200 - Consulter un document du bailleur",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('tokenBailleur') || !pm.environment.get('documentBailleurId')) {",
                  "    console.warn('Scenario ignore : fournir le JWT BAILLEUR et un UUID de document synthetique lui appartenant.');",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Type de contenu JSON', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "pm.test('Contrat JSON du document synthetique', function () {",
                  "    const document = pm.response.json();",
                  "    pm.expect(document.id).to.eql(pm.environment.get('documentBailleurId'));",
                  "    pm.expect(document.bailId).to.eql('bail-test-proprietaire');",
                  "    pm.expect(document.statut).to.eql('BROUILLON');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBailleur}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/quittances/{{documentBailleurId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "quittances",
                "{{documentBailleurId}}"
              ]
            }
          }
        },
        {
          "name": "404 - Document appartenant a un autre bailleur",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('tokenBailleur') || !pm.environment.get('documentAutreBailleurId')) {",
                  "    console.warn('Scenario ignore : fournir un JWT BAILLEUR et un UUID de document synthetique appartenant a un autre bailleur.');",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404 pour le document d un autre bailleur', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test('Erreur ProblemDetail identifiee', function () {",
                  "    const corps = pm.response.json();",
                  "    pm.expect(corps.status).to.eql(404);",
                  "    pm.expect(corps.code).to.eql('DOCUMENT_INTROUVABLE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBailleur}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/quittances/{{documentAutreBailleurId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "quittances",
                "{{documentAutreBailleurId}}"
              ]
            }
          }
        },
        {
          "name": "200 - Liste limitee aux documents du bailleur",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const requis = ['tokenBailleur', 'documentBailleurId', 'documentAutreBailleurId'];",
                  "if (requis.some(function (cle) { return !pm.environment.get(cle); })) {",
                  "    console.warn('Scenario ignore : fournir le JWT BAILLEUR et les deux UUID synthetiques du jeu de donnees isole.');",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Type de contenu JSON', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "pm.test('Structure de pagination', function () {",
                  "    const corps = pm.response.json();",
                  "    pm.expect(corps.contenu).to.be.an('array');",
                  "    pm.expect(corps.page).to.be.a('number');",
                  "    pm.expect(corps.taille).to.be.a('number');",
                  "    pm.expect(corps.totalElements).to.be.a('number');",
                  "    pm.expect(corps.totalPages).to.be.a('number');",
                  "});",
                  "pm.test('La liste contient le document propre et exclut le document tiers', function () {",
                  "    const ids = pm.response.json().contenu.map(function (document) { return document.id; });",
                  "    pm.expect(ids).to.include(pm.environment.get('documentBailleurId'));",
                  "    pm.expect(ids).to.not.include(pm.environment.get('documentAutreBailleurId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBailleur}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/quittances?taille=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "quittances"
              ],
              "query": [
                {
                  "key": "taille",
                  "value": "100"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
