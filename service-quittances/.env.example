# Base PostgreSQL
QUITTANCES_DB_NAME=quittances
QUITTANCES_DB_USER=quittances_dev
QUITTANCES_DB_PASSWORD=

# Paiements - serveur de simulation local
PAIEMENTS_MODE=SIMULATION
PAIEMENTS_BASE_URL=http://127.0.0.1:8091
PAIEMENTS_TOKEN=

# Locataires - serveur de simulation local
LOCATAIRES_MODE=SIMULATION
LOCATAIRES_BASE_URL=http://127.0.0.1:8091
LOCATAIRES_TOKEN=

# Biens - serveur de simulation local
BIENS_MODE=SIMULATION
BIENS_BASE_URL=http://127.0.0.1:8091
BIENS_TOKEN=

# Baux - adaptateur provisoire
BAUX_MODE=SIMULATION
BAUX_BASE_URL=http://127.0.0.1:8091
BAUX_TOKEN=

# Authentification locale
JWT_MODE=LOCAL
JWT_ISSUER=urn:gestionlocative:dev
JWT_AUDIENCE=service-quittances
JWT_PUBLIC_KEY_PATH=.local-jwt/public.der

# Stockage documentaire
QUITTANCES_STORAGE_PATH=./storage/quittances