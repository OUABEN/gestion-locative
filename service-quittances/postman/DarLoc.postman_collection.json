    {
      "name": "02 — Création et workflow (manuel)",
      "item": [
        {
          "name": "Préparer un brouillon",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/quittances",
            "description": "Bailleur propriétaire uniquement. Consulte les sources métier ; ne crée aucun paiement. Le document reste non signé et non émis.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bailId\": \"{{bailId}}\",\n  \"periodeDebut\": \"{{periodeDebut}}\",\n  \"periodeFin\": \"{{periodeFin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.environment.get('autoriserEcritures')!=='true'){console.warn('Ecriture desactivee');pm.execution.skipRequest();}",
                  "for(const cle of [\"bailId\", \"baseUrl\", \"periodeDebut\", \"periodeFin\", \"token\"]){if(!pm.environment.get(cle)){console.warn(\"Variable manquante : \"+cle);pm.execution.skipRequest();}}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Corps JSON lisible', () => { pm.response.json(); });",
                  "if (pm.response.code === 201) pm.environment.set('documentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Valider les informations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/quittances/{{documentId}}/valider",
            "description": "Bailleur propriétaire uniquement. Place le document en attente de signature ; ne signe pas le PDF.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirmation\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.environment.get('autoriserEcritures')!=='true'){console.warn('Ecriture desactivee');pm.execution.skipRequest();}",
                  "for(const cle of [\"baseUrl\", \"documentId\", \"token\"]){if(!pm.environment.get(cle)){console.warn(\"Variable manquante : \"+cle);pm.execution.skipRequest();}}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Corps JSON lisible', () => { pm.response.json(); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Archiver le brouillon",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/quittances/{{documentId}}/archives-brouillon",
            "description": "Bailleur propriétaire uniquement. Une archive par version. Le document n’est pas émis."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.environment.get('autoriserEcritures')!=='true'){console.warn('Ecriture desactivee');pm.execution.skipRequest();}",
                  "for(const cle of [\"baseUrl\", \"documentId\", \"token\"]){if(!pm.environment.get(cle)){console.warn(\"Variable manquante : \"+cle);pm.execution.skipRequest();}}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Corps JSON lisible', () => { pm.response.json(); });",
                  "if (pm.response.code === 201) pm.environment.set('archiveId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Signer et émettre en démonstration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/quittances/{{documentId}}/emission-demo",
            "description": "Bailleur propriétaire uniquement. Mode LOCAL sur 127.0.0.1 ; confirmation, document validé, certificat de test et paiements inchangés requis. Signature détachée de test, sans identité certifiée.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirmation\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.environment.get('autoriserEcritures')!=='true'){console.warn('Ecriture desactivee');pm.execution.skipRequest();}",
                  "for(const cle of [\"baseUrl\", \"documentId\", \"token\"]){if(!pm.environment.get(cle)){console.warn(\"Variable manquante : \"+cle);pm.execution.skipRequest();}}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Corps JSON lisible', () => { pm.response.json(); });",
                  "if (pm.response.code === 200) pm.test('Emission de demonstration', () => pm.expect(pm.response.json().modeSignature).to.eql('DEMONSTRATION'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Envoyer dans Mailpit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/quittances/{{documentId}}/envois-mailpit",
            "description": "Bailleur propriétaire uniquement. Document DEMO-QT émis et actif. Destinataire fictif généré côté serveur. Même requeteId : pas de nouveau SMTP ; résultat existant. Réessai autorisé seulement après échec avant transmission et délai de 30 secondes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requeteId\": \"{{requeteEnvoiId}}\",\n  \"confirmation\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.environment.get('autoriserEcritures')!=='true'){console.warn('Ecriture desactivee');pm.execution.skipRequest();}",
                  "for(const cle of [\"baseUrl\", \"documentId\", \"requeteEnvoiId\", \"token\"]){if(!pm.environment.get(cle)){console.warn(\"Variable manquante : \"+cle);pm.execution.skipRequest();}}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 ou 202', () => pm.expect([200,202]).to.include(pm.response.code));",
                  "if (pm.response.code===200) pm.test('Acceptation SMTP',()=>pm.expect(pm.response.json().statut).to.eql('ENVOYE'));",
                  "if (pm.response.code===202) pm.test('Tentative en cours',()=>pm.expect(pm.response.json().statut).to.eql('EN_ATTENTE_ENVOI'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 — Annulation et remplacement (manuel)",
      "item": [
        {
          "name": "Annuler avec motif",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/quittances/{{documentAnnulationId}}/annuler",
            "description": "Bailleur propriétaire uniquement. Conserve le document et l’historique. Ne pas lancer sur un document à garder actif.",
            "body": {
              "mode": "raw",
