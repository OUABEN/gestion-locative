{
  "info": {
    "name": "DarLoc — Quittances",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Routes réelles. Commencer par les GET. Écritures désactivées par défaut. Ne pas lancer toute la collection en automatique ; voir le guide."
  },
  "auth": {
    "type": "bearer",
