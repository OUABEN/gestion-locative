  "item": [
    {
      "name": "01 — Consultation",
      "item": [
        {
          "name": "État du service",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/systeme/etat",
            "description": "Réponse applicative minimale. Ne constitue pas une vérification exhaustive de PostgreSQL et des services externes.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "for(const cle of [\"baseUrl\"]){if(!pm.environment.get(cle)){console.warn(\"Variable manquante : \"+cle);pm.execution.skipRequest();}}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Corps JSON lisible', () => { pm.response.json(); });"
                ]
              }
            }
          ]
        },
        {
